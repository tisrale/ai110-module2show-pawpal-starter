classDiagram
    %% PawPal+ initial design (Phase 1 draft).
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task: Task) None
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str frequency
        +bool completed
        +str pet_name
        +mark_complete() None
        +priority_score() int
    }

    class Scheduler {
        +Owner owner
        +str day_start
        +list~Task~ scheduled
        +list~Task~ skipped
        +build_plan() list~Task~
        +sort_tasks(tasks: list~Task~) list~Task~
        +explain_plan() str
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : plans for
