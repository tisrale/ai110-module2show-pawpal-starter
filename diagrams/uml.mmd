classDiagram
    %% PawPal+ initial design (Phase 1 draft).
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task: Task) None
        +complete_task(task: Task) Task
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str frequency
        +bool completed
        +str pet_name
        +str time
        +date due_date
        +mark_complete() None
        +priority_score() int
        +next_occurrence() Task
    }

    class Scheduler {
        +Owner owner
        +str day_start
        +date plan_date
        +list~Task~ scheduled
        +list~Task~ skipped
        +list timeline
        +list~str~ conflicts
        +build_plan() list~Task~
        +sort_tasks(tasks: list~Task~) list~Task~
        +sort_by_time(tasks: list~Task~) list~Task~
        +filter_tasks(pet_name: str, completed: bool) list~Task~
        +mark_task_complete(task: Task) Task
        +detect_conflicts(tasks: list~Task~) list~str~
        +explain_plan() str
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : plans for
