classDiagram
    %% PawPal+ final design. Matches pawpal_system.py.
    %% "Task?" means the method can return None (no next occurrence).
    %% Module-level helpers used by Scheduler (not classes):
    %%   to_minutes(hhmm) -> int, to_hhmm(minutes) -> str, has_valid_time(task) -> bool

    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task: Task) None
        +complete_task(task: Task, completed_on: date) Task?
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str frequency
        +bool completed
        +str pet_name
        +str time
        +date due_date
        +mark_complete() None
        +priority_score() int
        +next_occurrence(completed_on: date) Task?
    }

    class Scheduler {
        +Owner owner
        +str day_start
        +date plan_date
        +list~Task~ scheduled
        +list~Task~ skipped
        +list~tuple~ timeline
        +list~str~ conflicts
        +build_plan() list~Task~
        +sort_tasks(tasks: list~Task~) list~Task~
        +sort_by_time(tasks: list~Task~) list~Task~
        +filter_tasks(pet_name: str, completed: bool) list~Task~
        +mark_task_complete(task: Task, completed_on: date) Task?
        +detect_conflicts(tasks: list~Task~) list~str~
        +explain_plan() str
        -_fixed_slots(tasks: list~Task~) list~tuple~
        -_assign_times(tasks: list~Task~) list~tuple~
    }

    note for Scheduler "timeline holds (start, end, Task) slots in minutes after midnight"

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : plans for
    Scheduler ..> Task : schedules / skips
    Scheduler ..> Pet : mark_task_complete calls complete_task
    Pet ..> Task : complete_task adds next occurrence
    Task ..> Task : next_occurrence creates
